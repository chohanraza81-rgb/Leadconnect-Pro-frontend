# ═══════════════════════════════════════════════════════════
# CLERK AUTHENTICATION
# ═══════════════════════════════════════════════════════════
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ═══════════════════════════════════════════════════════════
# BACKEND API
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=https://leadconnect-pro-backend-production-4f7711e5.up.railway.app/api

# ═══════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════
# 1. Copy this file to .env.local for local development:
#    cp .env.local.example .env.local
# 2. Replace placeholder values with your actual keys
# 3. NEVER commit .env.local to git — it's in .gitignore
# 4. On Netlify: set these in Site Settings → Environment Variables
# 5. Use pk_test_/sk_test_ for development, pk_live_/sk_live_ for production
